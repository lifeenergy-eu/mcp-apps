[Unit]
Description=Cloudways Magento Direct Server MCP
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/.project-brain/magento-server-mcp/current
EnvironmentFile=%h/.config/systemd/user/magento-server-mcp.env
ExecStart=%h/.project-brain/control-plane/controlled-execution-mcp/venv/bin/python %h/.project-brain/magento-server-mcp/current/apps/cloudways-magento-server-mcp/server.py
Restart=on-failure
RestartSec=5
UMask=0077
# Cron's setgid(crontab) helper needs privilege transition for the SAME login user.
# This service remains user-scoped; no sudo/root is granted by this setting.
# This trade-off is explicitly required for Cloudways user-crontab administration.
NoNewPrivileges=false

[Install]
WantedBy=default.target
