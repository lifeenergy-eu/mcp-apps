{
  "schema_version": "1.3",
  "app_id": "PRIVATE-INFRASTRUCTURE-ACCESS",
  "name": "Private Infrastructure Access",
  "version": "0.5.0",
  "status": "PRIVATE_CHATGPT_WEB_OAUTH_READY",
  "transport": "streamable-http",
  "path": "/mcp",
  "authentication_modes": [
    "BEARER_TOKEN_RUNTIME_SECRET_BOOTSTRAP",
    "PRIVATE_OAUTH_2_1_AUTHORIZATION_SERVER_AND_RESOURCE_SERVER"
  ],
  "default_authentication": "PRIVATE_OAUTH_2_1_AUTHORIZATION_SERVER_AND_RESOURCE_SERVER",
  "oauth": {
    "role": "EMBEDDED_PRIVATE_AUTHORIZATION_SERVER_AND_RESOURCE_SERVER",
    "client_registration": "DYNAMIC_CLIENT_REGISTRATION",
    "allowed_redirect_domains": [
      "chatgpt.com",
      "*.chatgpt.com",
      "openai.com",
      "*.openai.com"
    ],
    "authorization_code_flow": true,
    "pkce": "S256",
    "refresh_tokens": true,
    "access_token_storage": "SHA256_HASHED_SQLITE_RUNTIME_ONLY",
    "login": "SINGLE_OPERATOR_PASSWORD_RUNTIME_SECRET",
    "protected_resource_metadata": "SDK_GENERATED_RFC9728",
    "scopes": [
      "infra.read"
    ],
    "secrets_in_repository": false
  },
  "host_adapter_required": true,
  "host_read_contract": "FIXED_EXTERNAL_HELPER_JSON_STDIN_STDOUT",
  "read_only": true,
  "arbitrary_shell": false,
  "mutation_tools": false,
  "tools": [
    "connector_health",
    "system_info",
    "disk_usage",
    "service_status",
    "journal_read",
    "process_list",
    "socket_list",
    "file_read",
    "file_stat",
    "dir_list",
    "file_find",
    "hash_file",
    "git_read",
    "sqlite_read_only"
  ],
  "secret_values_in_repository": false,
  "product_data_path": "CHATGPT_WEB_DIRECT_HTTPS_TO_HOST",
  "cloudways_in_product_data_path": false,
  "remote_mcp": {
    "protocol": "streamable-http",
    "path": "/mcp",
    "direct_host_connection": true,
    "openai_plugin_compatible": true
  },
  "plugin_packaging": {
    "current": "CHATGPT_WEB_CUSTOM_MCP_OAUTH_READY",
    "custom_ui_required": false,
    "public_directory_submission": "FUTURE_GATE"
  }
}
